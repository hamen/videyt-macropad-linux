#!/usr/bin/env bash
# macropad-say <name> — types a canned phrase where the cursor is.
# Bound to single spare keysyms the macropad's second row emits (see
# macropad.yaml). No modifiers are involved, so nothing can latch/stick.
#
# Requires xdotool (X11 / Xwayland). On native Wayland, swap it for wtype/ydotool.
#
# To change the phrases: edit them below and re-run ./install.sh (the shortcut
# runs the installed copy at $BIN_DIR/macropad-say). No device reflash needed.
set -euo pipefail

case "${1:-}" in
  go)    text="go ahead, continue" ;;
  merge) text="merge the pull request, please" ;;
  stop)  text="stop" ;;
  *) echo "usage: macropad-say go|merge|stop" >&2; exit 2 ;;
esac

command -v xdotool >/dev/null 2>&1 || { echo "macropad-say: xdotool not found (needed to type)" >&2; exit 1; }

# The trigger key is still settling when the shortcut fires; without a brief pause
# xdotool's first characters get eaten. Pure timing — there are no modifiers to
# release here (that is deliberate; see macropad.yaml).
sleep 0.2
xdotool type --clearmodifiers -- "$text"
